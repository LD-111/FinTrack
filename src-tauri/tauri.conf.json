{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinTrack",
  "version": "0.1.0",
  "identifier": "com.fintrack.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FinTrack",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": true,
      "wix": {
        "upgradeCode": "27A2CD43-3604-535C-8964-039EC1CD1FEE"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMjQyNzI3M0QzQUQ3M0IKUldRNzF6bzlKeWNrY2wwRDZpZGdoNDNVZmc4VUJiVWVKSWlvd2tpZnY1MW4rZSs1eFVDQXU5TmIK",
      "endpoints": [
        "https://github.com/LD-111/FinTrack/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
